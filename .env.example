# Copy this file to .env and fill in your own values. Never commit .env.

# Comma-separated list of ccxt exchange ids to arbitrage between.
EXCHANGES=binance,coinbase,kraken,kucoin

# Default trading pair (ccxt unified symbol, BASE/QUOTE).
SYMBOL=BTC/USDT

# Per-exchange symbol overrides (comma-separated exchange:symbol pairs).
# Coinbase mostly lists BTC against USD rather than USDT.
#
# NOTE: the bot only ever compares exchanges quoting the EXACT SAME symbol
# string, so BTC/USDT is never directly compared against BTC/USD -- USDT and
# USD are not guaranteed to be worth exactly the same. If you want Coinbase
# genuinely included in opportunities, pair it with another exchange that
# also quotes BTC/USD, or accept that it will mostly sit idle as a USDT-only
# setup unless you change this override.
SYMBOL_OVERRIDES=coinbase:BTC/USD

# Safety switch. Must be explicitly set to "false" to place real orders.
# Everything defaults to a harmless dry run.
DRY_RUN=true

# --- Risk limits (amounts in quote currency, e.g. USD/USDT) ---
# These are conservative placeholders. Review and adjust before going live.
MAX_TRADE_USD=25
DAILY_LOSS_LIMIT_USD=50
MIN_PROFIT_PCT=0.5
SLIPPAGE_BUFFER_PCT=0.05

POLL_INTERVAL_SECONDS=5
DB_PATH=trades.db

# --- Web dashboard (view-only) ---
# Required to start the dashboard at all -- there is no unauthenticated mode.
# Basic Auth alone is not enough once this is reachable off localhost: put it
# behind HTTPS (nginx/Caddy reverse proxy) or an SSH tunnel. See README.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# --- API credentials ---
# The bot expects each exchange to already hold a balance of BOTH the base
# asset (e.g. BTC) and the quote currency (e.g. USDT) -- it trades
# independently on each side and does NOT transfer funds between exchanges
# in real time. Leave an exchange's keys blank to run it in read-only mode
# (price data only, no orders).
BINANCE_API_KEY=
BINANCE_API_SECRET=

COINBASE_API_KEY=
COINBASE_API_SECRET=

KRAKEN_API_KEY=
KRAKEN_API_SECRET=

KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
